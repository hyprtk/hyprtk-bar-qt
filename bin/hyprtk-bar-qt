#!/usr/bin/env bash
# Launch the hyprtk-bar-qt QML shell via Quickshell.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")" && pwd)"
root="$(cd "$here/.." && pwd)"

exec qs -p "$root" "$@"
